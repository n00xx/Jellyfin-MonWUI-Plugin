<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Runs against the built plugin via reflection, so it is free to target whichever
         runtime is installed locally; it does not have to match the plugin's net9.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>LocalTmdbBatch</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.JMSFusion.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
